# ==============================================================================
# Shuttle Management System - Environment Configuration Template
# Copy this file to .env and fill in your secure credentials before starting.
# NEVER commit the actual .env file or real secrets to version control!
# ==============================================================================

# ── Spring & Server ────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
APP_BASE_URL=http://localhost:8080

# ── Database Credentials ───────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3308
DB_NAME=shuttle_db
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password_here

# ── JWT Security & Expirations ────────────────────────────────────────────────
# Must be at least 256 bits (32 bytes) for HMAC-SHA256
JWT_SECRET=your-secure-random-256-bit-jwt-secret-string-must-be-long-enough-32bytes
JWT_EXPIRATION_MS=900000          # 15 minutes
JWT_REFRESH_EXPIRATION_MS=604800000 # 7 days

# ── Initial Admin Seed Credentials ────────────────────────────────────────────
ADMIN_SEED_EMAIL=admin@shuttle.dev
ADMIN_SEED_PASSWORD=Admin@SecurePassword123

# ── CORS Configuration (Admin Origins Only) ───────────────────────────────────
# Comma-separated list of allowed origins (e.g. admin web dashboard)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Payment Gateway Integration ───────────────────────────────────────────────
# Options: "mock" (for dev/test) or "payhere" (for production)
PAYMENT_GATEWAY=mock
PASS_MOCK_PAID=true

# PayHere Gateway Configuration (Only required when PAYMENT_GATEWAY=payhere)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true

# ── Firebase Cloud Messaging (FCM Push Notifications) ─────────────────────────
# Path to service account JSON file OR raw JSON string
FIREBASE_CONFIG_PATH=
FIREBASE_CREDENTIALS=

# ── Notification & Wallet Policies ───────────────────────────────────────────
WALLET_LOW_BALANCE_THRESHOLD=200.00
